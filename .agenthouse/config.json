{
  "schemaVersion": 1,
  "project": "agenthouse-autotour",
  "artifacts": {
    "outputs": [],
    "baselines": [],
    "cleanup": []
  },
  "autonomy": "bounded",
  "documentationAuthority": "git",
  "git": {
    "branchNaming": {
      "pattern": "{id}-{slug}",
      "example": "capture-login-record-login-flow",
      "baseDefault": "develop"
    }
  },
  "policySources": [
    ".agenthouse/policy.json"
  ],
  "evaluators": [
    {
      "id": "readiness",
      "kind": "work-item",
      "file": ".agenthouse/work/package-bootstrap.json",
      "stage": "plan"
    },
    {
      "id": "package-metadata",
      "kind": "command",
      "executable": "node",
      "args": [
        "scripts/check-package.mjs"
      ],
      "result": "exit-code"
    },
    {
      "id": "tests",
      "kind": "command",
      "executable": "node",
      "args": [
        "--test"
      ],
      "result": "exit-code"
    },
    {
      "id": "st-08-regeneration",
      "kind": "command",
      "executable": "node",
      "args": [
        "--test",
        "tests/regeneration/regenerate.test.js"
      ],
      "result": "exit-code",
      "criteria": [
        "plan-safety",
        "prerequisite-state",
        "selective-assets",
        "preserve-reusable",
        "assembled-output",
        "transactional-failure",
        "automation-interface"
      ]
    },
    {
      "id": "st-09-markdown-sync",
      "kind": "command",
      "executable": "node",
      "args": [
        "--test",
        "tests/publishing/markdown.test.js"
      ],
      "result": "exit-code",
      "criteria": [
        "managed-regions",
        "deterministic-assets",
        "publication-boundary",
        "marker-safety",
        "source-safety",
        "dry-run",
        "automation-interface"
      ]
    },
    {
      "id": "st-10-screenshot-capture",
      "kind": "command",
      "executable": "node",
      "args": [
        "--test",
        "tests/capture/screenshots.test.js",
        "tests/capture/generic.test.js",
        "tests/annotations/annotate-step.test.js"
      ],
      "result": "exit-code",
      "criteria": [
        "step-screenshots",
        "target-annotations",
        "manifest-assets",
        "capture-options",
        "failure-safety",
        "selective-regeneration",
        "automation-interface"
      ]
    }
  ],
  "profiles": {
    "pull-request": {
      "checks": [
        {
          "evaluator": "readiness",
          "required": true
        },
        {
          "evaluator": "package-metadata",
          "required": true
        },
        {
          "evaluator": "tests",
          "required": true
        },
        {
          "evaluator": "st-08-regeneration",
          "required": true
        },
        {
          "evaluator": "st-09-markdown-sync",
          "required": true
        },
        {
          "evaluator": "st-10-screenshot-capture",
          "required": true
        }
      ]
    }
  }
}
