{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autotour.dev/schemas/manual.schema.json",
  "title": "AutoTour manual",
  "description": "Combines several documentation specifications (for example one per application) into one manual per language.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "languages", "contents"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "organisation": { "enum": ["by-application", "by-use-case"] },
    "navigation": { "enum": ["sidebar", "topbar", "minimal"] },
    "numbering": { "type": "boolean", "default": true },
    "aiDisclosure": { "type": "object", "additionalProperties": false, "required": ["placement"], "properties": { "placement": { "enum": ["document", "chapter", "item", "none"] } } },
    "branding": { "$ref": "#/$defs/branding" },
    "images": { "type": "object", "additionalProperties": false, "properties": { "format": { "enum": ["original", "webp"] }, "quality": { "type": "integer", "minimum": 1, "maximum": 100 } } },
    "languages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["language", "label", "title", "specs", "targets"],
        "properties": {
          "language": { "type": "string", "pattern": "^[a-zA-Z]{2,8}(-[a-zA-Z0-9]{1,8})*$" },
          "label": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "specs": {
            "type": "object", "minProperties": 1,
            "propertyNames": { "$ref": "#/$defs/id" },
            "additionalProperties": {
              "type": "object", "additionalProperties": false, "required": ["spec"],
              "properties": {
                "spec": { "type": "string", "minLength": 1 },
                "walkthrough": { "type": "string", "minLength": 1 }
              }
            }
          },
          "parts": { "type": "object", "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "type": "string", "minLength": 1 } },
          "labels": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
          "targets": {
            "type": "array", "minItems": 1,
            "items": {
              "oneOf": [
                { "type": "object", "additionalProperties": false, "required": ["kind", "path"], "properties": { "kind": { "const": "html" }, "path": { "type": "string", "minLength": 1 }, "mode": { "enum": ["site", "single-file"] } } },
                { "type": "object", "additionalProperties": false, "required": ["kind", "path"], "properties": { "kind": { "const": "pdf" }, "path": { "type": "string", "minLength": 1 } } },
                { "type": "object", "additionalProperties": false, "required": ["kind", "path"], "properties": { "kind": { "const": "markdown" }, "path": { "type": "string", "minLength": 1 } } },
                { "type": "object", "additionalProperties": false, "required": ["kind", "path", "version"], "properties": { "kind": { "const": "larecipe" }, "path": { "type": "string", "minLength": 1 }, "version": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }, "assetsPath": { "type": "string", "minLength": 1 }, "assetsUrl": { "type": "string", "minLength": 1 } } }
              ]
            }
          }
        }
      }
    },
    "contents": {
      "type": "array", "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "object", "additionalProperties": false, "required": ["part"], "properties": { "part": { "$ref": "#/$defs/id" } } },
          {
            "type": "object", "additionalProperties": false, "required": ["spec"],
            "properties": {
              "spec": { "$ref": "#/$defs/id" },
              "section": { "$ref": "#/$defs/id" },
              "anchor": { "$ref": "#/$defs/id" }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "branding": {"type": "object", "additionalProperties": false, "properties": {"logo": {"type": "string", "minLength": 1}, "logoAlt": {"type": "string"}, "fontFamily": {"type": "string", "minLength": 1, "pattern": "^[^;{}<>]+$"}, "colors": {"type": "object", "additionalProperties": false, "properties": {"accent": {"$ref": "#/$defs/color"}, "text": {"$ref": "#/$defs/color"}, "background": {"$ref": "#/$defs/color"}, "muted": {"$ref": "#/$defs/color"}, "surface": {"$ref": "#/$defs/color"}, "border": {"$ref": "#/$defs/color"}}}}},
    "color": {"type": "string", "pattern": "^[#a-zA-Z0-9(),.% -]+$"},
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
  }
}
