{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autotour.dev/schemas/documentation.schema.json",
  "title": "AutoTour documentation specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "walkthroughId", "journey", "dependencyMap", "sections"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "walkthroughId": { "$ref": "#/$defs/id" },
    "journey": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "$ref": "#/$defs/journey" }
      ]
    },
    "dependencyMap": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "$ref": "#/$defs/dependencyMap" }
      ]
    },
    "audience": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "navigation": { "$ref": "#/$defs/navigation" },
    "numbering": { "type": "boolean" },
    "aiDisclosure": { "$ref": "#/$defs/aiDisclosure" },
    "labels": { "$ref": "#/$defs/labels" },
    "branding": { "$ref": "#/$defs/branding" },
    "images": { "$ref": "#/$defs/images" },
    "language": { "$ref": "#/$defs/languageTag" },
    "languageLabel": { "type": "string", "minLength": 1 },
    "translations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["language", "label", "spec"],
        "properties": {
          "language": { "$ref": "#/$defs/languageTag" },
          "label": { "type": "string", "minLength": 1 },
          "spec": { "type": "string", "minLength": 1 }
        }
      }
    },
    "viewport": {
      "type": "object", "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 320 },
        "height": { "type": "integer", "minimum": 240 }
      }
    },
    "destination": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": { "kind": { "const": "markdown" }, "path": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "siteUrl", "pageId"],
          "properties": {
            "kind": { "const": "confluence" },
            "siteUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
            "pageId": { "type": "string", "pattern": "^[0-9]+$" }
          }
        }
      ]
    },
    "targets": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/markdownTarget" },
          { "$ref": "#/$defs/htmlTarget" },
          { "$ref": "#/$defs/pdfTarget" },
          { "$ref": "#/$defs/larecipeTarget" },
          { "$ref": "#/$defs/confluenceTarget" }
        ]
      }
    },
    "generation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["create", "adapt"] },
        "htmlMode": { "enum": ["site", "single-file"] }
      }
    },
    "approval": {
      "type": "object", "additionalProperties": false,
      "properties": { "scope": { "enum": ["asset", "section", "run"] } }
    },
    "sections": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["moduleId", "heading", "blocks"],
        "properties": {
          "moduleId": { "$ref": "#/$defs/id" },
          "heading": { "type": "string", "minLength": 1 },
          "headingLevel": { "type": "integer", "minimum": 1, "maximum": 6, "default": 2 },
          "status": { "enum": ["ready", "planned", "text"], "default": "ready" },
          "endHeading": { "type": "string", "minLength": 1 },
          "dependencies": { "$ref": "#/$defs/dependencies" },
          "blocks": {
            "type": "array", "minItems": 1,
            "items": { "oneOf": [
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "text"],
                "properties": { "kind": { "const": "text" }, "text": { "type": "string", "minLength": 1 }, "origin": { "$ref": "#/$defs/origin" } }
              },
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "stepId", "sourceView", "alt", "caption", "timing"],
                "properties": {
                  "kind": { "const": "screenshot" },
                  "stepId": { "$ref": "#/$defs/id" },
                  "sourceView": { "type": "string", "minLength": 1 },
                  "alt": { "type": "string", "minLength": 1 },
                  "caption": { "type": "string", "minLength": 1 },
                  "timing": { "enum": ["before", "after"] },
                  "origin": { "$ref": "#/$defs/origin" },
                  "captionInImage": { "type": "boolean", "default": true },
                  "captionPlacement": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
                  "callout": { "type": "integer", "minimum": 1 },
                  "target": {
                    "type": "object", "additionalProperties": false,
                    "oneOf": [
                      { "required": ["role", "name"], "properties": { "role": {}, "name": {} } },
                      { "required": ["text"], "properties": { "text": {} } },
                      { "required": ["css"], "properties": { "css": {} } },
                      { "required": ["testId"], "properties": { "testId": {} } }
                    ],
                    "properties": {
                      "role": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                      "name": { "type": "string", "minLength": 1 },
                      "text": { "type": "string", "minLength": 1 },
                      "css": { "type": "string", "minLength": 1 },
                      "testId": { "type": "string", "minLength": 1 },
                      "index": { "type": "integer", "minimum": 0 }
                    }
                  }
                }
              },
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "url", "label"],
                "properties": {
                  "kind": { "const": "tour" },
                  "url": { "type": "string", "format": "uri", "pattern": "^https://" },
                  "label": { "type": "string", "minLength": 1 }
                }
              },
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "path", "label"],
                "properties": {
                  "kind": { "const": "video" },
                  "path": { "type": "string", "minLength": 1 },
                  "label": { "type": "string", "minLength": 1 },
                  "caption": { "type": "string", "minLength": 1 },
                  "still": { "type": "string", "minLength": 1 },
                  "origin": { "$ref": "#/$defs/origin" }
                }
              },
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "document", "operation"],
                "properties": {
                  "kind": { "const": "openapi" },
                  "document": { "type": "string", "minLength": 1 },
                  "operation": {
                    "type": "string",
                    "pattern": "^(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS|TRACE) /\\S+$"
                  }
                }
              },
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "path", "still", "label"],
                "properties": {
                  "kind": { "const": "embed" },
                  "path": { "type": "string", "minLength": 1 },
                  "still": { "type": "string", "minLength": 1 },
                  "label": { "type": "string", "minLength": 1 },
                  "caption": { "type": "string", "minLength": 1 },
                  "readyMessage": { "type": "object", "minProperties": 1, "additionalProperties": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }] } },
                  "origin": { "$ref": "#/$defs/origin" }
                }
              }
            ] }
          }
        }
      }
    }
  },
  "$defs": {
    "journey": { "type": "object", "required": ["schemaVersion", "id", "modules"], "properties": { "schemaVersion": { "const": 1 }, "id": { "$ref": "#/$defs/id" }, "modules": { "type": "array" } }, "additionalProperties": true },
    "dependencyMap": { "type": "object", "required": ["schemaVersion", "rules"], "properties": { "schemaVersion": { "const": 1 }, "rules": { "type": "array" } }, "additionalProperties": true },
    "markdownTarget": { "type": "object", "additionalProperties": false, "required": ["kind", "path"], "properties": { "kind": { "const": "markdown" }, "path": { "type": "string", "minLength": 1 } } },
    "htmlTarget": { "type": "object", "additionalProperties": false, "required": ["kind", "path"], "properties": { "kind": { "const": "html" }, "path": { "type": "string", "minLength": 1 }, "mode": { "enum": ["site", "single-file"] } } },
    "pdfTarget": { "type": "object", "additionalProperties": false, "required": ["kind", "path"], "properties": { "kind": { "const": "pdf" }, "path": { "type": "string", "minLength": 1 } } },
    "confluenceTarget": { "type": "object", "additionalProperties": false, "required": ["kind", "siteUrl", "pageId"], "properties": { "kind": { "const": "confluence" }, "siteUrl": { "type": "string", "format": "uri", "pattern": "^https://" }, "pageId": { "type": "string", "pattern": "^[0-9]+$" } } },
    "larecipeTarget": { "type": "object", "additionalProperties": false, "required": ["kind", "path", "version"], "properties": { "kind": { "const": "larecipe" }, "path": { "type": "string", "minLength": 1 }, "version": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }, "assetsPath": { "type": "string", "minLength": 1 }, "assetsUrl": { "type": "string", "minLength": 1 } } },
    "origin": { "enum": ["human", "ai-generated", "ai-modified"] },
    "navigation": { "enum": ["sidebar", "topbar", "minimal"] },
    "aiDisclosure": { "type": "object", "additionalProperties": false, "required": ["placement"], "properties": { "placement": { "enum": ["document", "chapter", "item", "none"] } } },
    "labels": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "branding": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "logo": { "type": "string", "minLength": 1 },
        "logoAlt": { "type": "string" },
        "fontFamily": { "type": "string", "minLength": 1, "pattern": "^[^;{}<>]+$" },
        "colors": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "accent": { "$ref": "#/$defs/color" }, "text": { "$ref": "#/$defs/color" }, "background": { "$ref": "#/$defs/color" },
            "muted": { "$ref": "#/$defs/color" }, "surface": { "$ref": "#/$defs/color" }, "border": { "$ref": "#/$defs/color" }
          }
        }
      }
    },
    "color": { "type": "string", "pattern": "^[#a-zA-Z0-9(),.% -]+$" },
    "images": { "type": "object", "additionalProperties": false, "properties": { "format": { "enum": ["original", "webp"] }, "quality": { "type": "integer", "minimum": 1, "maximum": 100 } } },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "languageTag": { "type": "string", "pattern": "^[a-zA-Z]{2,8}(-[a-zA-Z0-9]{1,8})*$" },
    "dependencies": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "views": { "$ref": "#/$defs/strings" },
        "controllers": { "$ref": "#/$defs/strings" },
        "apiEndpoints": { "$ref": "#/$defs/strings" },
        "backend": { "$ref": "#/$defs/strings" }
      }
    },
    "strings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
