{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autotour.dev/schemas/walkthrough.schema.json",
  "title": "AutoTour modular walkthrough",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "target", "outputs", "modules"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "pattern": "^[a-zA-Z]{2,8}(-[a-zA-Z0-9]{1,8})*$" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseUrl", "goal"],
      "properties": {
        "baseUrl": { "type": "string", "format": "uri" },
        "goal": { "type": "string", "minLength": 1 }
      }
    },
    "publish": { "type": "boolean", "default": false },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["dom", "video", "screenshots"] }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/module" }
    }
  },
  "$defs": {
    "target": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "css": { "type": "string", "minLength": 1 },
        "testId": { "type": "string", "minLength": 1 },
        "index": { "type": "integer", "minimum": 0 }
      },
      "oneOf": [
        { "properties": { "role": {}, "name": {} }, "required": ["role", "name"] },
        { "properties": { "text": {} }, "required": ["text"] },
        { "properties": { "css": {} }, "required": ["css"] },
        { "properties": { "testId": {} }, "required": ["testId"] }
      ]
    },
    "condition": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "selector": { "type": "string", "minLength": 1 },
        "target": { "$ref": "#/$defs/target" },
        "state": { "enum": ["attached", "detached", "visible", "hidden"] },
        "count": { "type": "integer", "minimum": 0 },
        "minimumCount": { "type": "integer", "minimum": 0 },
        "text": { "type": "string" },
        "networkIdle": { "type": "boolean" },
        "stableForMs": { "type": "integer", "minimum": 0, "maximum": 30000 },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 30000 }
      }
    },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "views": { "$ref": "#/$defs/stringList" },
        "controllers": { "$ref": "#/$defs/stringList" },
        "apiEndpoints": { "$ref": "#/$defs/stringList" },
        "backend": { "$ref": "#/$defs/stringList" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "action": { "enum": ["goto", "click", "fill", "select", "scroll", "assert", "wait"] },
        "description": { "type": "string", "minLength": 1 },
        "target": { "$ref": "#/$defs/target" },
        "instruction": { "type": "string" },
        "optional": { "type": "boolean" },
        "narration": { "type": "string" },
        "pauseAfterMs": { "type": "integer", "minimum": 0, "maximum": 30000 },
        "until": { "$ref": "#/$defs/condition" },
        "expect": { "$ref": "#/$defs/condition" },
        "selector": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "value": { "type": "string" },
        "valueEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "durationMs": { "type": "integer", "minimum": 0, "maximum": 30000 },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 30000 },
        "url": { "type": "string", "minLength": 1 },
        "state": { "enum": ["attached", "detached", "visible", "hidden"] },
        "scroll": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "x", "y", "durationMs"],
          "properties": {
            "mode": { "enum": ["by", "to"] },
            "x": { "type": "number" },
            "y": { "type": "number" },
            "durationMs": { "type": "integer", "minimum": 0, "maximum": 30000 }
          }
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "route", "steps", "dependencies", "assets"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "route": { "type": "string", "minLength": 1 },
        "publish": { "type": "boolean" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/step" }
        },
        "setup": { "type": "array", "items": { "$ref": "#/$defs/step" } },
        "dependencies": { "$ref": "#/$defs/dependencies" },
        "assets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dom": { "type": "string" },
            "video": { "type": "string" },
            "screenshots": { "$ref": "#/$defs/stringList" }
          }
        }
      }
    }
  }
}
