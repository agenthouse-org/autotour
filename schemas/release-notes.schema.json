{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agenthouse-org/autotour/schemas/release-notes.schema.json",
  "title": "AutoTour release notes",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "walkthroughId", "range", "status", "reviewRequired", "commits", "modules", "noVisibleChange", "audiences"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "walkthroughId": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "head", "baseCommit", "headCommit"],
      "properties": {
        "base": { "type": "string", "minLength": 1 },
        "head": { "type": "string", "minLength": 1 },
        "baseCommit": { "$ref": "#/$defs/sha" },
        "headCommit": { "$ref": "#/$defs/sha" }
      }
    },
    "status": { "enum": ["draft", "approved"] },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by", "at", "digest"],
      "properties": {
        "by": { "type": "string", "minLength": 1 },
        "at": { "type": "string", "format": "date-time" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "acceptedReview": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "reviewRequired": { "type": "boolean" },
    "unmappedFiles": { "$ref": "#/$defs/stringList" },
    "commits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha", "subject", "date", "merge", "changedFiles", "modules", "unmappedFiles", "workItems"],
        "properties": {
          "sha": { "$ref": "#/$defs/sha" },
          "subject": { "type": "string" },
          "date": { "type": "string", "format": "date-time" },
          "merge": { "type": "boolean" },
          "changedFiles": { "$ref": "#/$defs/stringList" },
          "modules": { "type": "array", "items": { "$ref": "#/$defs/id" } },
          "unmappedFiles": { "$ref": "#/$defs/stringList" },
          "workItems": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "title": { "type": "string" },
                "outcome": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "status", "commits", "images"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "type": "string", "minLength": 1 },
          "status": { "enum": ["regenerate", "review", "reusable"] },
          "commits": { "type": "array", "items": { "$ref": "#/$defs/sha" } },
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["asset", "after", "before"],
              "properties": {
                "asset": { "type": "string", "minLength": 1 },
                "after": { "type": ["string", "null"] },
                "before": { "type": ["string", "null"] },
                "beforeSource": { "enum": ["baseline-dir", "git"] }
              }
            }
          }
        }
      }
    },
    "noVisibleChange": { "type": "array", "items": { "$ref": "#/$defs/sha" } },
    "audiences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["developer", "po", "pm"],
      "properties": {
        "developer": { "$ref": "#/$defs/entries" },
        "po": { "$ref": "#/$defs/entries" },
        "pm": { "$ref": "#/$defs/entries" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{40}(?:[a-f0-9]{24})?$" },
    "stringList": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "refs"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
