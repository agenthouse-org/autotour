{
  "name": "autotour",
  "version": "0.1.0",
  "description": "Agent-driven modular walkthrough and product documentation generation for web applications.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Valerio Neri",
    "email": "valerio.neri@neri.de"
  },
  "keywords": [
    "playwright",
    "product-documentation",
    "walkthrough",
    "browser-automation",
    "coding-agent",
    "agent-plugin"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenthouse-org/autotour.git"
  },
  "homepage": "https://github.com/agenthouse-org/autotour#readme",
  "bugs": {
    "url": "https://github.com/agenthouse-org/autotour/issues"
  },
  "bin": {
    "autotour": "bin/autotour.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./schema": "./schemas/walkthrough.schema.json",
    "./dependency-map-schema": "./schemas/dependency-map.schema.json"
  },
  "files": [
    "bin",
    "src",
    "schemas",
    "skills",
    "examples",
    "docs",
    ".codex-plugin",
    ".claude-plugin",
    ".cursor",
    ".agents/plugins/marketplace.json",
    "plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-force-exit",
    "check": "node scripts/check-package.mjs && npm test",
    "prepack": "npm run check"
  },
  "dependencies": {
    "@rrweb/record": "^2.1.6",
    "@rrweb/replay": "^2.1.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "playwright": "^1.63.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  }
}
