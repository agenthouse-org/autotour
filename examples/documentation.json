{
  "$schema": "../schemas/documentation.schema.json",
  "schemaVersion": 1,
  "walkthroughId": "profile-documentation",
  "journey": "documentation-journey.json",
  "dependencyMap": "documentation-dependencies.json",
  "audience": "Product users updating their profile",
  "viewport": { "width": 1280, "height": 720 },
  "destination": { "kind": "markdown", "path": "profile.md" },
  "sections": [{
