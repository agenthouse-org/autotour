        "timing": "after",
        "target": { "role": "textbox", "name": "Display name" },
        "callout": 1,
        "alt": "Profile Settings with the display name field highlighted",
        "caption": "Your new display name is ready to save."
      },
      { "kind": "text", "text": "Changes take effect after saving." }
    ]
  }]
