{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthouse.org/schemas/webtour/tour.schema.json",
  "title": "agenthouse-webtour tour",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "steps"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "feature": { "type": "string" },
    "autoOffer": { "type": "boolean", "default": false },
    "audience": {
      "type": "array",
      "items": { "type": "string" }
    },
    "locales": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "steps": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": { "type": "string" },
                "body": { "type": "string" },
                "html": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "target": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "selector": { "type": "string" },
                  "wait": { "type": "string" },
                  "timeout": { "type": "number", "minimum": 0 }
                }
              }
            ]
          },
          "placement": {
            "type": "string",
            "enum": ["top", "bottom", "left", "right", "auto"]
          },
          "orphan": { "type": "boolean" },
          "advanceOnTarget": { "type": "boolean" },
          "advanceWhen": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["selector"],
                "properties": {
                  "selector": { "type": "string", "minLength": 1 },
                  "timeout": { "type": "number", "minimum": 0 }
                }
              }
            ]
          },
          "blockTarget": { "type": "boolean" },
          "path": { "type": "string" },
          "onMissing": {
            "type": "string",
            "enum": ["skip", "end", "orphan", "error"]
          }
        }
      }
    }
  }
}
